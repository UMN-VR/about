{
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@foss-earth/about": "file:deps/foss-earth-about-75277f70092cd8d18679f87a94361f83c779c6ad.tgz",
    "@foss-earth/ci": "file:deps/foss-earth-ci-1db73d1ddb342e348a2c9e8387f7bbc7ebb3225e.tgz",
    "@types/node": "24.12.4",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "vite": "8.3.4"
  },
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./content": {
      "import": "./src/content.mjs",
      "types": "./dist/content.d.mts"
    },
    "./graph.json": "./docs/proposals/repository-split-graph.json",
    "./panel": {
      "import": "./src/panel.mjs",
      "types": "./dist/panel.d.mts"
    }
  },
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "SOURCE_PROVENANCE.json",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "migration": {
    "state": "SOURCE_ONLY; independent Campus host graph support and exact About75277f adoption; own declarations/CI queued",
    "lockQualification": "Inherited lock preserved; offline repair only after grant"
  },
  "name": "@umn-vr/about",
  "peerDependencies": {
    "@foss-earth/about": "0.1.0"
  },
  "private": true,
  "repository": "https://github.com/UMN-VR/about",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist --incremental --tsBuildInfoFile node_modules/.tmp/about-build.tsbuildinfo",
    "build:graph": "foss-earth-repository-graph --input=docs/proposals/repository-split-graph.json --out=docs/proposals/repository-split-graph.html",
    "check:attribution": "node node_modules/@foss-earth/ci/bin/attribution.mjs --repo . --refs-file intended-publication-refs.json",
    "check:conformance": "node node_modules/@foss-earth/ci/bin/conformance.mjs --consumer . --trusted-release .attribution-release.json --output-root .local/build/conformance",
    "check:implementation": "npm run typecheck && npm run lint && npm test && npm run build",
    "ci": "npm run check:conformance && npm run check:implementation",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/about.tsbuildinfo"
  },
  "type": "module",
  "version": "0.1.0"
}
